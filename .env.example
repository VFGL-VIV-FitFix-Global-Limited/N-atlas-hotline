#  N-ATLAS Backend 

NATLAS_BACKEND=huggingface

# N-ATLAS Gateway API (only when NATLAS_BACKEND=gateway)
NATLAS_ASR_URL=https://api.natlas.ng/asr
NATLAS_LLM_URL=https://api.natlas.ng/llm
NATLAS_API_KEY=your_natlas_api_key
# NATLAS_BASE_URL=https://your-openai-compatible-host

# Hugging Face (required when NATLAS_BACKEND=huggingface or local)
# Get your token at https://huggingface.co/settings/tokens
# You must first request access to the gated model: https://huggingface.co/NCAIR1/N-ATLaS
HF_TOKEN=hf_your_token_here
HF_MODEL_ID=NCAIR1/N-ATLaS
NATLAS_DEVICE=auto

# Africa's Talking
AT_USERNAME=your_username
AT_API_KEY=your_api_key
AT_PHONE_NUMBER=+234XXXXXXXXXX

# WhatsApp (Meta Cloud API)
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_access_token
WA_VERIFY_TOKEN=your_webhook_verify_token
WA_APP_SECRET=your_meta_app_secret
WA_GRAPH_VERSION=v21.0

# Twilio WhatsApp Sandbox
# Sign up at https://twilio.com → Console → Messaging → WhatsApp Sandbox
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
# This is the Twilio sandbox number — do NOT change it unless you have your own Twilio WhatsApp number

# App
APP_BASE_URL=https://your-deployed-url.com
DATABASE_PATH=data/hotline.db
KNOWLEDGE_PATH=knowledge/
FAISS_INDEX_PATH=data/faiss_index
AUDIO_DIR=data/audio
LOG_LEVEL=INFO
ENVIRONMENT=development

# Security
API_SECRET_KEY=your_secret_key_for_stats_endpoint
PHONE_HASH_SALT=your_random_salt_string_min_16_chars

# Rate Limiting
RATE_LIMIT_CALLS_PER_MINUTE=10
RATE_LIMIT_WHATSAPP_PER_MINUTE=20
